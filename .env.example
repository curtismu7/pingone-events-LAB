# Optional. Everything has a safe default; Mock needs no tenant and no credentials. Real settings normally live in the shared settings file
# (~/Development/.env; STANDALONE_ENV overrides it), not here. This file is git-ignored.
# PORT must be 7803 (this app's one allocated port).
PORT=7803
# PEV_BIND=127.0.0.1   # loopback only unless you set this on purpose

# Real mode, read-only pull (owner-run): a PingOne worker app that can read subscriptions and activities.
# PINGONE_ENVIRONMENT_ID=
# PINGONE_REGION=com
# PINGONE_CLIENT_ID=
# PINGONE_CLIENT_SECRET=

# Forward each event to YOUR Elasticsearch or OpenSearch (switched OFF in the page until you turn it on).
# ELASTICSEARCH_URL=https://your-cluster.example:9200
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_INDEX=pingone-events

# Hosted (SE) only, normally from the Kubernetes Secret: see k8s/secret.example.yaml.
# PEV_HOSTED=1  WEBHOOK_ALLOWED_HOSTS=  WEBHOOK_BASIC_USER=  WEBHOOK_BASIC_PASSWORD=  UI_BASIC_USER=  UI_BASIC_PASSWORD=
